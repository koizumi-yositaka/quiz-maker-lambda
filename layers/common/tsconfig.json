{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./nodejs/node_modules/@app/common",
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}